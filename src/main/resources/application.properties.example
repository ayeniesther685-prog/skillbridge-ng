# Copy this to application.properties and fill in real values.
# application.properties is gitignored — DO NOT commit it.

server.port=8081
spring.application.name=skillbridge

spring.datasource.url=jdbc:postgresql://localhost:5432/skillbridge
spring.datasource.username=postgres
spring.datasource.password=CHANGEME
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=false

management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=when-authorized

springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.path=/swagger-ui.html

# Generate with: openssl rand -base64 48
app.jwt.secret=CHANGEME_AT_LEAST_32_BYTES
app.jwt.access-token-ttl-seconds=900
app.jwt.refresh-token-ttl-seconds=604800
app.jwt.issuer=skillbridge

app.ai.gemini.api-key=CHANGEME
app.ai.gemini.model=gemini-3.1-flash-lite
app.ai.gemini.base-url=https://generativelanguage.googleapis.com/v1beta
app.ai.gemini.timeout-seconds=30

app.wallet.points-to-naira-rate=10.00
app.wallet.currency=PTS

payments.paystack.enabled=false
payments.paystack.secret-key=
payments.paystack.public-key=
payments.paystack.base-url=https://api.paystack.co
payments.paystack.webhook-secret=
payments.transfer.enabled=false
