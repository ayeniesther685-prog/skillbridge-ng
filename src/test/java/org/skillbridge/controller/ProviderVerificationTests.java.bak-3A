package org.skillbridge.controller;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.skillbridge.entity.Role;
import org.skillbridge.entity.User;
import org.skillbridge.enums.RoleName;
import org.skillbridge.repository.RoleRepository;
import org.skillbridge.repository.UserRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.test.context.ActiveProfiles;
import org.springframework.test.web.servlet.MockMvc;

import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

@SpringBootTest
@AutoConfigureMockMvc
@ActiveProfiles("test")
class ProviderVerificationTests {

    @Autowired private MockMvc mvc;
    @Autowired private ObjectMapper json;
    @Autowired private UserRepository userRepo;
    @Autowired private RoleRepository roleRepo;
    @Autowired private PasswordEncoder encoder;

    private String clientToken;
    private String adminToken;
    private Long clientId;

    @BeforeEach
    void setup() throws Exception {
        String clientEmail = "client-" + System.nanoTime() + "@example.com";
        var regBody = """
            {
              "firstName":"Client","lastName":"One",
              "email":"%s",
              "password":"TestPass123",
              "phone":"08000000000",
              "roles":["CLIENT"]
            }
            """.formatted(clientEmail);

        // Register returns 201 Created (per AuthController)
        var res = mvc.perform(post("/api/auth/register")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(regBody))
                .andExpect(status().isCreated())
                .andReturn();

        JsonNode body = json.readTree(res.getResponse().getContentAsString());
        clientToken = body.get("accessToken").asText();
        clientId = body.get("user").get("id").asLong();

        // Create admin directly (bypasses self-register-block)
        String adminEmail = "admin-" + System.nanoTime() + "@example.com";
        User admin = new User();
        admin.setFirstName("Admin");
        admin.setLastName("One");
        admin.setEmail(adminEmail);
        admin.setPassword(encoder.encode("AdminPass123"));
        admin.setActive(true);
        Role adminRole = roleRepo.findByName(RoleName.ADMIN).orElseThrow();
        admin.addRole(adminRole);
        userRepo.save(admin);

        var loginBody = """
            {"email":"%s","password":"AdminPass123"}
            """.formatted(adminEmail);

        // Login returns 200 OK
        var loginRes = mvc.perform(post("/api/auth/login")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(loginBody))
                .andExpect(status().isOk())
                .andReturn();

        adminToken = json.readTree(loginRes.getResponse().getContentAsString())
                .get("accessToken").asText();
    }

    @Test
    void publicStatusEndpoint_returnsUnverifiedForNoRow() throws Exception {
        mvc.perform(get("/api/providers/" + clientId + "/verification-status"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.userId").value(clientId))
                .andExpect(jsonPath("$.status").value("UNVERIFIED"))
                .andExpect(jsonPath("$.verified").value(false));
    }

    @Test
    void meVerification_requiresAuth() throws Exception {
        mvc.perform(get("/api/providers/me/verification"))
                .andExpect(status().isUnauthorized());
    }

    @Test
    void submit_movesToPending() throws Exception {
        String body = """
            {
              "providerType":"EMPLOYER",
              "legalName":"Acme Ltd",
              "cacRegistrationNumber":"RC123456",
              "officialEmail":"hr@acme.com",
              "officialPhone":"+2347000000000",
              "physicalAddress":"12 Test St",
              "authorizedRepName":"Ada Obi",
              "authorizedRepRole":"Director"
            }
            """;

        mvc.perform(post("/api/providers/me/verification/submit")
                        .contentType(MediaType.APPLICATION_JSON)
                        .header("Authorization", "Bearer " + clientToken)
                        .content(body))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.status").value("PENDING"))
                .andExpect(jsonPath("$.legalName").value("Acme Ltd"))
                .andExpect(jsonPath("$.submittedAt").isNotEmpty());
    }

    @Test
    void jobPost_blockedUntilVerified() throws Exception {
        String jobBody = """
            {
              "title":"Test job","description":"desc",
              "budgetMin":1000,"budgetMax":5000,
              "location":"Lagos","jobType":"FULL_TIME",
              "experienceLevel":"ENTRY","skillIds":[]
            }
            """;

        mvc.perform(post("/api/jobs")
                        .contentType(MediaType.APPLICATION_JSON)
                        .header("Authorization", "Bearer " + clientToken)
                        .content(jobBody))
                .andExpect(status().isForbidden());

        String verifBody = """
            {
              "providerType":"EMPLOYER","legalName":"Acme Ltd",
              "officialEmail":"hr@acme.com","officialPhone":"+2347000000000",
              "physicalAddress":"12 Test St",
              "authorizedRepName":"Ada Obi","authorizedRepRole":"Director"
            }
            """;

        var submitRes = mvc.perform(post("/api/providers/me/verification/submit")
                        .contentType(MediaType.APPLICATION_JSON)
                        .header("Authorization", "Bearer " + clientToken)
                        .content(verifBody))
                .andExpect(status().isOk())
                .andReturn();

        Long verifId = json.readTree(submitRes.getResponse().getContentAsString())
                .get("id").asLong();

        mvc.perform(post("/api/jobs")
                        .contentType(MediaType.APPLICATION_JSON)
                        .header("Authorization", "Bearer " + clientToken)
                        .content(jobBody))
                .andExpect(status().isForbidden());

        mvc.perform(post("/api/admin/provider-verifications/" + verifId + "/approve")
                        .contentType(MediaType.APPLICATION_JSON)
                        .header("Authorization", "Bearer " + adminToken)
                        .content("{\"reason\":\"Verified for test\"}"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.status").value("VERIFIED"));

        mvc.perform(post("/api/jobs")
                        .contentType(MediaType.APPLICATION_JSON)
                        .header("Authorization", "Bearer " + clientToken)
                        .content(jobBody))
                .andExpect(status().isCreated())
                .andExpect(jsonPath("$.title").value("Test job"));
    }

    @Test
    void adminEndpoints_requireAdminRole() throws Exception {
        mvc.perform(get("/api/admin/provider-verifications")
                        .header("Authorization", "Bearer " + clientToken))
                .andExpect(status().isForbidden());

        mvc.perform(get("/api/admin/provider-verifications")
                        .header("Authorization", "Bearer " + adminToken))
                .andExpect(status().isOk());
    }
}
